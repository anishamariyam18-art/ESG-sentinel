# Copy to .env and fill in real values. Never commit .env.

ENVIRONMENT=development
LOG_LEVEL=INFO

# --- LLM provider ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_NAME=gemini-3.6-flash

# --- Embedding / reranking models ---
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
CROSS_ENCODER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2

# --- Uploads ---
MAX_UPLOAD_SIZE_MB=25

# --- LLM call tuning (LLMConfig) ---
LLM__MAX_RETRIES=2
LLM__TEMPERATURE=0.0
LLM__REQUEST_TIMEOUT_SECONDS=60

# --- Analyzer batching (AnalyzerConfig) ---
ANALYZER__MAX_BATCH_CHARS=12000
ANALYZER__MAX_CHUNKS_PER_BATCH=40
ANALYZER__MAX_SCHEMA_RETRIES=1

# --- Analyzer confidence weights (AnalyzerConfidenceWeights) -- must sum to 1.0 ---
ANALYZER_CONFIDENCE__SOURCE_COVERAGE=0.25
ANALYZER_CONFIDENCE__EXTRACTION_COMPLETENESS=0.20
ANALYZER_CONFIDENCE__STRUCTURED_FIELD_AVAILABILITY=0.25
ANALYZER_CONFIDENCE__MODEL_RESPONSE_VALIDITY=0.20
ANALYZER_CONFIDENCE__PARSING_QUALITY=0.10

# --- Chunking (ChunkingConfig) ---
CHUNKING__TARGET_CHUNK_CHARS=1000
CHUNKING__MAX_CHUNK_CHARS=1600
CHUNKING__MIN_CHUNK_CHARS=150

# --- Claim extraction batching (ClaimsConfig) ---
CLAIMS__MAX_BATCH_CHARS=12000
CLAIMS__MAX_CHUNKS_PER_BATCH=40
CLAIMS__MAX_SCHEMA_RETRIES=1
CLAIMS__MIN_CLAIM_LENGTH=15
CLAIMS__NEAR_DUPLICATE_SIMILARITY_THRESHOLD=0.85
CLAIMS__MAX_CLASSIFICATION_BATCH_SIZE=25

# --- Claim confidence weights (ClaimConfidenceWeights) -- must sum to 1.0 ---
CLAIM_CONFIDENCE__ESG_RELEVANCE=0.20
CLAIM_CONFIDENCE__PROVENANCE_COMPLETENESS=0.20
CLAIM_CONFIDENCE__CLASSIFICATION_CERTAINTY=0.25
CLAIM_CONFIDENCE__NUMERICAL_CLARITY=0.20
CLAIM_CONFIDENCE__CLAIM_COMPLETENESS=0.15

# --- Evidence extraction/indexing (EvidenceConfig) ---
EVIDENCE__CORROBORATION_SIMILARITY_THRESHOLD=0.5
EVIDENCE__MAX_CORROBORATING_CHUNKS_PER_CLAIM=2
EVIDENCE__DEFAULT_TOP_K=10
EVIDENCE__MIN_EVIDENCE_TEXT_LENGTH=10
EVIDENCE__STORAGE_FILENAME=evidence_store.json

# --- Hybrid retrieval (RetrievalConfig) ---
RETRIEVAL__TOP_K=5
RETRIEVAL__LEXICAL_WEIGHT=0.4
RETRIEVAL__SEMANTIC_WEIGHT=0.6
RETRIEVAL__RERANK_ENABLED=true
RETRIEVAL__MIN_FINAL_SCORE=0.0

# --- Verification status thresholds (VerificationThresholds), 0-100 scale ---
VERIFICATION__VERIFIED_SCORE_MIN=80.0
VERIFICATION__PARTIALLY_VERIFIED_SCORE_MIN=60.0
VERIFICATION__NUMERICAL_TOLERANCE_PCT=2.0

# --- Verification score weights (VerificationWeights) -- must sum to 1.0 ---
VERIFICATION_WEIGHTS__SEMANTIC=0.15
VERIFICATION_WEIGHTS__LEXICAL=0.10
VERIFICATION_WEIGHTS__NUMERIC=0.20
VERIFICATION_WEIGHTS__UNIT=0.10
VERIFICATION_WEIGHTS__TEMPORAL=0.10
VERIFICATION_WEIGHTS__ENTITY=0.10
VERIFICATION_WEIGHTS__CATEGORY=0.05
VERIFICATION_WEIGHTS__LLM_SUPPORT=0.15
VERIFICATION_WEIGHTS__PROVENANCE=0.05

# --- Verification confidence weights (VerificationConfidenceWeights) -- must sum to 1.0 ---
VERIFICATION_CONFIDENCE__PROVENANCE_QUALITY=0.30
VERIFICATION_CONFIDENCE__SIGNAL_AGREEMENT=0.25
VERIFICATION_CONFIDENCE__LLM_RELIABILITY=0.25
VERIFICATION_CONFIDENCE__LOW_AMBIGUITY=0.20

# --- Verification engine tuning (VerificationConfig) ---
VERIFICATION_ENGINE__CANDIDATES_PER_CLAIM=5
VERIFICATION_ENGINE__MAX_LLM_JUDGMENT_CANDIDATES=3
VERIFICATION_ENGINE__UPLOADED_REPORT_PRIORITY_BONUS=0.05
VERIFICATION_ENGINE__MAX_SCHEMA_RETRIES=1
# include_current_document (default) | external_evidence_only -- Phase 10 section 26 data-leakage policy
VERIFICATION_ENGINE__DEFAULT_EVIDENCE_POLICY=include_current_document

# --- Greenwashing risk thresholds (GreenwashingThresholds), 0-100 scale ---
GREENWASHING__HIGH_RISK_MIN=60.0
GREENWASHING__MEDIUM_RISK_MIN=30.0

# --- Greenwashing score weights (GreenwashingWeights) -- must sum to 1.0 ---
GREENWASHING_WEIGHTS__LACK_OF_EVIDENCE_SUPPORT=0.20
GREENWASHING_WEIGHTS__NUMERICAL_INCONSISTENCY=0.20
GREENWASHING_WEIGHTS__CONTRADICTION=0.20
GREENWASHING_WEIGHTS__VAGUENESS=0.05
GREENWASHING_WEIGHTS__ABSOLUTE_LANGUAGE=0.10
GREENWASHING_WEIGHTS__UNSUPPORTED_BENEFIT=0.08
GREENWASHING_WEIGHTS__MISSING_QUALIFICATION=0.07
GREENWASHING_WEIGHTS__MISLEADING_COMPARISON=0.05
GREENWASHING_WEIGHTS__WEAK_PROVENANCE=0.05

# --- Greenwashing confidence weights (GreenwashingConfidenceWeights) -- must sum to 1.0 ---
GREENWASHING_CONFIDENCE__PROVENANCE_RELIABILITY=0.35
GREENWASHING_CONFIDENCE__EVIDENCE_RELIABILITY=0.35
GREENWASHING_CONFIDENCE__LLM_RELIABILITY=0.30

# --- Greenwashing report aggregation (GreenwashingAggregationConfig) ---
GREENWASHING_AGGREGATION__MAX_HIGH_RISK_BONUS=10.0
GREENWASHING_AGGREGATION__HIGH_RISK_BONUS_SCALE=25.0
GREENWASHING_AGGREGATION__NEUTRAL_IMPORTANCE_WEIGHT=0.5
GREENWASHING_AGGREGATION__MAX_SCHEMA_RETRIES=1

# --- Trust Score component weights (TrustScoreWeights) -- must sum to 1.0 ---
TRUST_WEIGHTS__CLAIM_SUPPORT=0.30
TRUST_WEIGHTS__EVIDENCE_QUALITY=0.20
TRUST_WEIGHTS__CONSISTENCY=0.15
TRUST_WEIGHTS__TRANSPARENCY=0.15
TRUST_WEIGHTS__GREENWASHING_RISK=0.15
TRUST_WEIGHTS__PROVENANCE=0.05

# --- Trust Score rating thresholds (TrustRatingThresholds), 0-100 scale ---
TRUST_RATING__EXCELLENT_MIN=80.0
TRUST_RATING__GOOD_MIN=60.0
TRUST_RATING__MODERATE_MIN=40.0

# --- Trust Score tuning (TrustScoreConfig) ---
TRUST_SCORE__VERIFIED_CREDIT=1.0
TRUST_SCORE__PARTIALLY_VERIFIED_CREDIT=0.5
TRUST_SCORE__UNSUPPORTED_CREDIT=0.0
TRUST_SCORE__NO_GREENWASHING_DATA_DEFAULT=70.0
TRUST_SCORE__HIGH_RISK_PENALTY_SCALE=40.0
TRUST_SCORE__MEDIUM_RISK_PENALTY_SCALE=15.0
TRUST_SCORE__MAX_GREENWASHING_PENALTY=50.0
TRUST_SCORE__MIN_CLAIMS_FOR_FULL_CONFIDENCE=30
TRUST_SCORE__ENABLE_LLM_NARRATIVE=true
TRUST_SCORE__MAX_SCHEMA_RETRIES=1

# --- Recommendation priority weights (RecommendationPriorityWeights) -- must sum to 1.0 ---
RECOMMENDATION_PRIORITY__SEVERITY=0.30
RECOMMENDATION_PRIORITY__AFFECTED_CLAIMS=0.20
RECOMMENDATION_PRIORITY__VERIFICATION_IMPACT=0.15
RECOMMENDATION_PRIORITY__GREENWASHING_RISK=0.15
RECOMMENDATION_PRIORITY__TRUST_IMPACT=0.10
RECOMMENDATION_PRIORITY__CLAIM_IMPORTANCE=0.10

# --- Recommendation priority thresholds (RecommendationThresholds), 0-100 scale ---
RECOMMENDATION_THRESHOLDS__HIGH_PRIORITY_MIN=70.0
RECOMMENDATION_THRESHOLDS__MEDIUM_PRIORITY_MIN=40.0

# --- Recommendation engine tuning (RecommendationConfig) ---
RECOMMENDATIONS__MAX_RECOMMENDATIONS=10
RECOMMENDATIONS__MAX_PRIORITY_ACTIONS=5
RECOMMENDATIONS__MAX_SOURCE_FINDINGS_PER_RECOMMENDATION=5
RECOMMENDATIONS__NUMERICAL_MISMATCH_THRESHOLD=0.8
RECOMMENDATIONS__PROVENANCE_COMPLETENESS_THRESHOLD=0.5
RECOMMENDATIONS__WEAK_COMPONENT_THRESHOLD=60.0
RECOMMENDATIONS__LOW_EVIDENCE_COVERAGE_THRESHOLD=70.0
RECOMMENDATIONS__AFFECTED_CLAIMS_FULL_CREDIT=10
RECOMMENDATIONS__ENABLE_LLM_SYNTHESIS=true
RECOMMENDATIONS__MAX_SCHEMA_RETRIES=1
